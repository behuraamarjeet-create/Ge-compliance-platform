{
  "kind": "collectionType",
  "collectionName": "tenders",
  "info": {
    "singularName": "tender",
    "pluralName": "tenders",
    "displayName": "Tenders"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string" },
    "tenderId": { "type": "string", "unique": true },
    "description": { "type": "text" },
    "department": { "type": "string" },
    "statusId": {
      "type": "enumeration",
      "enum": ["Open", "Closed", "Awarded"],
      "default": "Open"
    },
    "bidderCount": { "type": "integer" },
    "publishedDate": { "type": "datetime" },
    "closingDate": { "type": "datetime" },
    "createdAtDate": { "type": "datetime" },
    "bidderApplications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::bidder-application.bidder-application",
      "mappedBy": "tender"
    }
  }
}
